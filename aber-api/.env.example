NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase: use the Session pooler connection string. URL-encode special characters in the password.
# Illustrative shape only. Put the real value in your local .env, never in Git.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres
DATABASE_SSL=true

# Used only by `npm run seed:admin`. Set it in your shell or local .env, never commit it.
# ADMIN_PASSWORD=

# Added in Phase 3:
# JWT_SECRET=
# JWT_EXPIRES_IN=8h
